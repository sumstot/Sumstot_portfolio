<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% page_title = current_page.data.title || t("meta.title") %>
    <title><%= page_title %></title>
    <meta name="description" content="<%= t("meta.description") %>">

    <link rel="canonical" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="en" href="<%= absolute_url('/') %>">
    <link rel="alternate" hreflang="ja" href="<%= absolute_url('/ja/') %>">
    <link rel="alternate" hreflang="x-default" href="<%= absolute_url('/') %>">

    <link rel="icon" href="<%= image_path('favicon.svg') %>" type="image/svg+xml">
    <link rel="icon" href="<%= image_path('favicon-32.png') %>" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="<%= image_path('apple-touch-icon.png') %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Soren Umstot">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= t('meta.description') %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= absolute_url(image_path('og.jpg')) %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="<%= I18n.locale == :ja ? 'ja_JP' : 'en_US' %>">
    <meta property="og:locale:alternate" content="<%= I18n.locale == :ja ? 'en_US' : 'ja_JP' %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= t('meta.description') %>">
    <meta name="twitter:image" content="<%= absolute_url(image_path('og.jpg')) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "site" %>

    <script type="application/ld+json"><%= person_schema %></script>
  </head>
  <body>
    <%= yield %>

    <%# Refreshes the ramen and reading feeds past what the build captured.
        Deferred and failure-tolerant: with it blocked or broken the page is
        exactly the static one it was before. %>
    <%= javascript_include_tag "live", defer: true %>
  </body>
</html>
