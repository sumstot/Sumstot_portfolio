<section id="about" class="py-20 px-8 md:px-16 max-w-7xl mx-auto">
  <p class="sec-label reveal">About</p>
  <h2 class="font-bold mb-10 reveal" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.1; color: var(--fg);">
    Rails artisan,<br>ramen ranger.
  </h2>

  <!--
    Grid layout (3 cols):
    Row 1: Bio (col 1, row-span 2) | Location (col 2) | Ramen count (col 3)
    Row 2: [Bio cont.]             | Core Stack (col 2-3, col-span 2)
    Row 3: 8+ years (col 1)        | SD→Osaka (col 2)
  -->
  <div class="grid gap-4 reveal"
       style="grid-template-columns: repeat(3, 1fr); grid-template-rows: auto auto auto;">

    <!-- Bio — spans rows 1–2 -->
    <div class="bento flex flex-col justify-between"
         style="grid-column: 1; grid-row: 1 / 3;">
      <div>
        <p class="text-sm leading-relaxed mb-5" style="color: var(--muted);">
          Originally from San Diego, now rooted in Osaka. I build production Rails
          applications with a focus on Hotwire, Stimulus, and Kamal — lean, modern
          stacks deployed to VPS without the cloud overhead.
        </p>
        <p class="text-sm leading-relaxed" style="color: var(--muted);">
          By night, I maintain a curated database of 250+ Kansai ramen shops, each
          personally visited and rated. The two obsessions are more related than
          they look — both reward deep attention to craft.
        </p>
      </div>
      <div class="flex items-center gap-2 mt-6">
        <span class="status-dot"></span>
        <span class="text-sm" style="color: var(--muted);">Open to consulting</span>
      </div>
    </div>

    <!-- Location card -->
    <div class="bento" style="grid-column: 2; grid-row: 1;">
      <div class="icon-box">📍</div>
      <p class="font-semibold mb-1" style="color: var(--fg);">Osaka, Japan</p>
      <p class="text-sm mb-2" style="color: var(--muted);">34.69° N · 135.50° E</p>
      <p class="text-sm font-mono font-semibold" style="color: var(--em);"
         data-clock-target="display">—:—:— JST</p>
    </div>

    <!-- Ramen count card -->
    <div class="bento" style="grid-column: 3; grid-row: 1;">
      <div class="icon-box">🍜</div>
      <p class="font-bold mb-1" style="font-size: 2rem; color: var(--fg);">250+</p>
      <p class="text-sm" style="color: var(--muted);">Ramen bowls<br>reviewed in Kansai</p>
    </div>

    <!-- Core stack card — spans cols 2-3 -->
    <div class="bento" style="grid-column: 2 / 4; grid-row: 2;">
      <p class="sec-label mb-3">Core Stack</p>
      <div class="flex flex-wrap gap-2">
        <span class="tag">Rails 8</span>
        <span class="tag">Hotwire</span>
        <span class="tag">Stimulus</span>
        <span class="tag">Kamal</span>
        <span class="tag">SQLite</span>
        <span class="tag">PostgreSQL</span>
        <span class="tag">Docker</span>
        <span class="tag">Tailwind</span>
        <span class="tag">JavaScript</span>
        <span class="tag">Ruby</span>
      </div>
    </div>

    <!-- Years experience card (calculated at build time) -->
    <% years_exp = ((Date.today - Date.new(2023, 3, 13)) / 365.25).round %>
    <div class="bento" style="grid-column: 1; grid-row: 3;">
      <div class="icon-box">&lt;/&gt;</div>
      <p class="font-bold mb-1" style="font-size: 2rem; color: var(--fg);"><%= years_exp %> years+</p>
      <p class="text-sm" style="color: var(--muted);">Professional<br>experience</p>
    </div>

    <!-- San Diego → Osaka card -->
    <div class="bento" style="grid-column: 2; grid-row: 3;">
      <div class="icon-box">✈️</div>
      <p class="font-semibold mb-1" style="color: var(--fg);">San Diego → Osaka</p>
      <p class="text-sm" style="color: var(--muted);">US expat,<br>Japan-based 2018–</p>
    </div>

  </div>
</section>
