<section id="ramen" class="py-20 px-6 max-w-5xl mx-auto" data-controller="ramen">
  <p class="sec-label reveal">🍜 Ramen Quest</p>
  <h2 class="text-3xl font-bold mb-3 reveal" style="color: var(--fg);">200+ Bowls &amp; Counting</h2>
  <p class="mb-10 reveal" style="color: var(--muted);">Tracking the best ramen shops across Japan.</p>

  <!-- Skeleton placeholders — replaced by ramen_controller -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 reveal" data-ramen-target="grid">
    <% 3.times do %>
      <div class="ramen-card">
        <div class="ramen-img" style="background: var(--bg2);"></div>
        <div class="p-4">
          <div class="h-3 rounded mb-2" style="background: var(--border); width: 70%;"></div>
          <div class="h-2 rounded"      style="background: var(--border); width: 50%;"></div>
        </div>
      </div>
    <% end %>
  </div>
</section>
