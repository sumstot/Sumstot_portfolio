<section id="projects" class="py-20 px-6 max-w-5xl mx-auto">
  <p class="sec-label reveal">Projects</p>
  <h2 class="text-3xl font-bold mb-10 reveal" style="color: var(--fg);">Things I've built</h2>

  <div class="flex flex-col gap-6">
    <% data.projects.each_with_index do |project, i| %>
      <div class="proj-card reveal">
        <% if i.even? %>
          <div>
            <%= image_tag project.image, alt: "#{project.name} screenshot", class: 'proj-img' %>
          </div>
          <div class="proj-wrap">
            <p class="sec-label"><%= project.role %></p>
            <h3 class="text-xl font-bold" style="color: var(--fg);"><%= project.name %></h3>
            <p class="text-sm leading-relaxed" style="color: var(--muted);"><%= project.description %></p>
            <div class="flex flex-wrap gap-2">
              <% project.stacks.split(',').first(4).each do |stack| %>
                <span class="tag"><%= stack.strip %></span>
              <% end %>
            </div>
            <a href="<%= project.url %>" target="_blank" class="btn-em self-start mt-1">View Site →</a>
          </div>
        <% else %>
          <div class="proj-wrap">
            <p class="sec-label"><%= project.role %></p>
            <h3 class="text-xl font-bold" style="color: var(--fg);"><%= project.name %></h3>
            <p class="text-sm leading-relaxed" style="color: var(--muted);"><%= project.description %></p>
            <div class="flex flex-wrap gap-2">
              <% project.stacks.split(',').first(4).each do |stack| %>
                <span class="tag"><%= stack.strip %></span>
              <% end %>
            </div>
            <a href="<%= project.url %>" target="_blank" class="btn-em self-start mt-1">View Site →</a>
          </div>
          <div>
            <%= image_tag project.image, alt: "#{project.name} screenshot", class: 'proj-img' %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
